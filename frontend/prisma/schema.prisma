// Unified User schema — Spring Boot is the sole source of truth for users.
// NextAuth uses JWT sessions only (no Prisma adapter, no DB tables needed).
// All user data (credentials + OAuth) lives in the Spring Boot `users` table.
// Prisma is kept for potential future data needs, but is not used for auth.

generator client {
  provider = "prisma-client-js"
  engineType = "library"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// NOTE: The actual `users` table (Spring Boot/JPA) is managed by the backend,
// NOT by Prisma. This Prisma schema is kept minimal and may be extended
// later for non-auth data if needed (e.g., analytics, cache).
//
// The `nextauth_users` table that existed before was for NextAuth v4 with
// Prisma adapter. It has been replaced by a pure-JWT approach where
// NextAuth sessions are stateless and backed entirely by Spring Boot.
//
// To avoid Prisma migrate conflict with the real `users` table managed by
// the backend, we don't define a User model here.
